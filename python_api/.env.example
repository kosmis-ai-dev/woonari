# AI 없이 계산만 실행하려면 요청에 include_ai: false
WOONARI_ENV=development
# 운영은 패키지 밖의 전용 영속 디렉터리 절대 경로를 지정하세요.
WOONARI_STATE_DIR=
AI_PROVIDER=bedrock
BEDROCK_AUTH_MODE=api_key
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_ACCOUNT_ID=
# api_key 선택 시 실제로 확인된 AI 전용 AWS 계정 ID(12자리)를 입력합니다.
# 승인한 AI 계정의 Claude 추론 프로필과 리전
BEDROCK_MODEL_ID=
BEDROCK_REGION=
BEDROCK_MAX_TOKENS=8192
# OpenAI 선택 시에만 AI_PROVIDER=openai와 아래 키·모델 설정
OPENAI_API_KEY=
# 계정에서 사용 가능한 Responses structured outputs 지원 모델 ID
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENCY=4
AI_DAILY_CALL_LIMIT=100
# 설정하면 기존 운세 /v1 요청에 X-API-Key 필요. 소셜 로그인은 별도 Bearer 토큰 사용.
API_KEY=

# 개발 초기값. 실제 서비스/운영은 mysql과 아래 연결값을 모두 지정하세요.
WOONARI_DB_BACKEND=sqlite
WOONARI_DB_HOST=
WOONARI_DB_PORT=3306
WOONARI_DB_NAME=woonari
WOONARI_DB_USER=
WOONARI_DB_PASSWORD=
# 사설 CA가 필요하면 서버 인증서 검증용 CA 파일의 절대 경로
WOONARI_DB_CA_FILE=

# 운영은 HTTPS 주소로 바꾸고 매체 콘솔에도 동일한 callback을 등록하세요.
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:9090
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
