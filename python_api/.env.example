# AI 없이 계산만 실행하려면 요청에 include_ai: false
AI_PROVIDER=bedrock
BEDROCK_AUTH_MODE=iam
# api_key 선택 시 .local/woonari/ai/bedrock.env의 전용 키를 사용합니다.
BEDROCK_ACCOUNT_ID=
# api_key 선택 시 실제로 확인된 AI 전용 AWS 계정 ID(12자리)를 입력합니다.
# Woonari 전용 AWS 프로필에서 호출 가능한 Claude 추론 프로필
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_REGION=ap-northeast-2
BEDROCK_MAX_TOKENS=8192
# OpenAI 선택 시에만 AI_PROVIDER=openai와 아래 키·모델 설정
OPENAI_API_KEY=
# 계정에서 사용 가능한 Responses structured outputs 지원 모델 ID
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENCY=4
AI_DAILY_CALL_LIMIT=100
# 설정하면 기존 운세 /v1 요청에 X-API-Key 필요. 소셜 로그인은 별도 Bearer 토큰 사용.
API_KEY=

# 소셜 앱 설정은 .local/woonari/auth/providers.env 전용 파일을 사용합니다.
# ./woonari auth init 명령으로 준비하세요.
